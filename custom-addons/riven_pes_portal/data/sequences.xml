        </record>
        <record id="seq_pes_warranty_registration" model="ir.sequence">
            <field name="name">PES Warranty Registration</field>
            <field name="code">pes.warranty.registration</field>
            <field name="prefix">WR-%(year)s</field>
            <field name="padding">5</field>
        </record>
    </data>
</riven_erp>
