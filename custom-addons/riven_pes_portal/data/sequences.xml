            <field name="name">PES Support Ticket</field>
            <field name="code">pes.support.ticket</field>
            <field name="prefix">TKT-%(year)s</field>
            <field name="padding">5</field>
        </record>
        <record id="seq_pes_rma" model="ir.sequence">
            <field name="name">PES RMA</field>
            <field name="code">pes.rma</field>
            <field name="prefix">RMA-%(year)s</field>
