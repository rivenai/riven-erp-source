<riven_erp>
    <!-- Public About page — photorealistic rebuild (0.0.08) -->
    <template id="about_page" name="About PES Supply">
        <t t-call="website.layout">
            <div class="position-relative overflow-hidden" style="height:420px;">
                <img src="/riven_pes_portal/static/img/hero_warehouse.jpg" alt="PES Supply warehouse"
                     class="w-100 h-100" style="object-fit:cover;"/>
                <div class="position-absolute top-0 start-0 w-100 h-100"
                     style="background:linear-gradient(rgba(6,32,16,0.78),rgba(6,32,16,0.30));"></div>
                <div class="position-absolute top-50 start-50 translate-middle text-center text-white w-75">
                    <h1 class="fw-bold" style="font-size:3rem;">PES Supply</h1>
                    <p class="fs-4 mb-0">Electrical &amp; solar supply, delivered like it matters.</p>
                </div>
            </div>

            <div class="container py-5" style="max-width: 960px;">
                <div class="text-center mb-5">
                    <h2 class="fw-bold mb-3">A century of supply, a modern platform</h2>
                    <p class="text-muted fs-5 mx-auto" style="max-width:720px;">
                        Since 1921, PES Supply has kept electricians, contractors, and utilities
                        working. Today we pair deep electrical and solar inventory with a modern
                        digital platform — quote requests, order tracking, warranty registration,
                        and support, all in one portal.
                    </p>
                </div>

                <div class="row text-center g-4 mb-5">
                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded-3" style="background:#F4F8F4;">
                            <div class="fw-bold" style="font-size:2rem;color:#0C882A;">1921</div>
                            <div class="text-muted small text-uppercase">Founded</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded-3" style="background:#F4F8F4;">
                            <div class="fw-bold" style="font-size:2rem;color:#0C882A;">50,000+</div>
                            <div class="text-muted small text-uppercase">SKUs</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded-3" style="background:#F4F8F4;">
                            <div class="fw-bold" style="font-size:2rem;color:#0C882A;">169</div>
                            <div class="text-muted small text-uppercase">Brands</div>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 rounded-3" style="background:#F4F8F4;">
                            <div class="fw-bold" style="font-size:2rem;color:#0C882A;">18+</div>
                            <div class="text-muted small text-uppercase">Portal Users</div>
                        </div>
                    </div>
                </div>

                <h3 class="fw-bold mb-4 text-center">What we build</h3>
                <div class="row g-4 mb-5">
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm overflow-hidden h-100">
                            <img src="/riven_pes_portal/static/img/gallery_solarfarm.jpg" alt="Utility-scale solar farm"
                                 class="card-img-top" style="height:260px;object-fit:cover;"/>
                            <div class="card-body">
                                <h5 class="fw-bold">Utility-Scale Solar</h5>
                                <p class="text-muted mb-0">Panels, racking, inverters, and energy storage for commercial and utility projects.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card border-0 shadow-sm overflow-hidden h-100">
                            <img src="/riven_pes_portal/static/img/gallery_carport.jpg" alt="Solar carport with EV charging"
                                 class="card-img-top" style="height:260px;object-fit:cover;"/>
                            <div class="card-body">
                                <h5 class="fw-bold">Solar Carports &amp; EV</h5>
                                <p class="text-muted mb-0">Canopy structures and EV charging infrastructure for commercial facilities.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="text-center mb-5">
                    <h3 class="fw-bold mb-4">Certified &amp; compliant</h3>
                    <div class="d-flex justify-content-center flex-wrap gap-4">
                        <img src="/riven_pes_portal/static/img/badge_nabcep.png" alt="NABCEP Certified" style="width:110px;height:110px;"/>
                        <img src="/riven_pes_portal/static/img/badge_bbb.png" alt="BBB A+ Rated" style="width:110px;height:110px;"/>
                        <img src="/riven_pes_portal/static/img/badge_ul.png" alt="UL Listed" style="width:110px;height:110px;"/>
                        <img src="/riven_pes_portal/static/img/badge_baba.png" alt="BABA Compliant" style="width:110px;height:110px;"/>
                    </div>
                </div>

                <div class="text-center pb-4">
                    <a href="/my" class="btn btn-lg text-white px-5" style="background:#0C882A;">Sign in to your portal</a>
                </div>
            </div>
        </t>
    </template>
</riven_erp>
